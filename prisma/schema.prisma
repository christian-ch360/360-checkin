// =============================================================================
// LOCATIONS / SCAN EVENTS
// =============================================================================

enum LocationType {
  ENTRANCE
  BOOTH
  PODCAST_ROOM
  RECORDING_STUDIO
  BEAUTY_CHAIR
  ROOFTOP
  CONFERENCE_ROOM
  EDITING_BAY
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  type           LocationType
  active         Boolean      @default(true)
  capacity       Int?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanEvents   ScanEvent[]
  qrAsset      QRAsset?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("locations")
}

enum ScanEventAction {
  FACILITY_CHECK_IN
  FACILITY_CHECK_OUT
  SPACE_ENTER
  SPACE_EXIT
  VISITOR_CHECK_IN
  VISITOR_CHECK_OUT
}

// Append-only audit log of every QR scan handled by the kiosk. Never updated
// after creation ("do not overwrite previous records") — occupancy and
// per-location session durations are always derived by reading history, the
// same way Space occupancy is already computed fresh from SpaceSession/
// Reservation rows elsewhere in this schema rather than stored.
model ScanEvent {
  id           String          @id @default(uuid()) @db.Uuid
  memberId     String?         @db.Uuid
  visitorId    String?         @db.Uuid
  locationId   String?         @db.Uuid
  // Denormalized copies of the location's name/type at scan time, so this
  // row's meaning survives a location being later renamed, retyped, or
  // deleted — matches the audit-log intent (a rename shouldn't rewrite
  // history).
  locationName String
  locationType String
  deviceId     String?
  action       ScanEventAction
  timestamp    DateTime        @default(now())
  notes        String?

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  visitor  Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([locationId])
  @@index([timestamp])
  @@map("scan_events")
}

// =============================================================================
// EMAIL
// =============================================================================

// DELIVERED/OPENED/CLICKED/BOUNCED/COMPLAINED are unused today — they exist
// so a future Resend webhook handler (keyed off EmailLog.providerId) has
// somewhere to write delivery-event status without another migration.
enum EmailStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

// Backs the Email Center dashboard's Category filter/breakdown. Derived
// automatically from the template name (see TEMPLATE_CATEGORY) — never set
// by call sites directly.
enum EmailCategory {
  AUTHENTICATION
  MEMBERSHIP
  COMMUNITY
  MESSAGING
  PROJECTS
  SPACES
  EVENTS
  ADMIN
  BILLING
  MARKETING
  SYSTEM
}

// One row per EmailService.send call — backs the Admin Communications email
// history/delivery-status view, the Email Center dashboard, and the queue's
// retry bookkeeping. Never the source of truth for whether an email
// "actually happened" beyond Resend's own record; this is CreatorHub360's
// local audit trail of attempts.
model EmailLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  to             String
  recipientName  String?
  subject        String
  template       String
  category       EmailCategory
  status         EmailStatus   @default(QUEUED)
  provider       String        @default("resend")
  providerId     String?
  from           String?
  // No producer sets this today — the sync-send path has no reply-to
  // concept — but it's schema-ready for when one does.
  replyTo        String?
  html           String?       @db.Text
  text           String?       @db.Text
  error          String?
  memberId       String?       @db.Uuid
  sentById       String?       @db.Uuid
  attempts       Int           @default(0)
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation("EmailLogRecipient", fields: [memberId], references: [id], onDelete: SetNull)
  sentBy       Member?      @relation("EmailLogSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([memberId])
  @@map("email_logs")
}

// =============================================================================
// MEMBERSHIP APPLICATIONS
// =============================================================================

enum MembershipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// The public "Apply to Join" form writes only here — never a Member, never a
// Supabase auth user. Approving one is what actually provisions the account
// (see approveApplicationAction), reusing the same onboarding path as
// admin-created members. Named MembershipApplication (not Application) since
// that name is already taken by the unrelated Collab Hub job-application model.
model MembershipApplication {
  id                         String                      @id @default(uuid()) @db.Uuid
  organizationId             String                      @db.Uuid
  fullName                   String
  email                      String
  phone                      String
  role                       MemberRole
  company                    String?
  website                    String?
  businessRegistrationNumber String?
  instagram                  String?
  tiktok                     String?
  youtube                    String?
  city                       String?
  state                      String?
  country                    String?
  reason                     String?
  referredBy                 String?
  // Structured affiliate tracking, distinct from the freeform `referredBy`
  // text field above — the exact referral code (e.g. "AGY-001284") that was
  // active (via QR/link param or manual entry) when this application was
  // submitted. Validated against a real, active referrer at submit time; see
  // ReferralLink for the full audit trail this feeds.
  referralCode               String?
  // "Existing Agency Claim Workflow" — set when the applicant chose "Request
  // Access to Existing Agency" instead of registering a duplicate. Plain
  // scalar (no FK), same pattern as referralCode above: validated in
  // application code (see approveApplicationAction), not enforced at the DB
  // layer, since the target agency is looked up by id at approval time.
  claimedAgencyId            String?                     @db.Uuid
  claimedAgencyRole          AgencyMemberRole?
  // "Creator Request Notes" — the applicant's answer to "Why are you
  // requesting to join this agency?", captured alongside the claim above and
  // copied onto the AgencyAccessRequest at approval time (see
  // approveApplicationAction / requestAgencyAccess).
  claimRequestNote           String?
  // Set when this application originated from an Owner/Manager's team
  // invitation link — an admin-issued invite IS the agency-side approval,
  // so approveApplicationAction auto-joins the new Member directly instead
  // of creating a pending AgencyAccessRequest. Plain scalar (no FK), same
  // pattern as claimedAgencyId.
  agencyInviteToken          String?
  status                     MembershipApplicationStatus @default(PENDING)
  notes                      String?
  notesUpdatedAt             DateTime?
  notesUpdatedById           String?                     @db.Uuid
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  reviewedAt                 DateTime?
  reviewedById               String?                     @db.Uuid

  organization     Organization                           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy       Member?                                @relation("MembershipApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  notesUpdatedBy   Member?                                @relation("MembershipApplicationNotesUpdatedBy", fields: [notesUpdatedById], references: [id], onDelete: SetNull)
  legalAcceptances MembershipApplicationLegalAcceptance[]
  referralLink     ReferralLink?

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("membership_applications")
}

// =============================================================================
// AFFILIATE / REFERRAL TRACKING
// =============================================================================
//
// A generic, role-agnostic referral engine — today only AGENCY-role members
// get a code (see REFERRAL_ELIGIBLE_ROLES in
// features/referrals/config/referral-config.ts), but nothing here is
// Agency-specific: referrerRole is stored per-link precisely so Brand/
// Broker/Business Development/Staff referral IDs can be turned on later by
// extending that one config array — no schema change required.

// One row per referral relationship, created the moment a MembershipApplication
// is submitted with a referral code (QR scan, link param, or manual entry) and
// updated (never replaced) as that application is approved and the resulting
// Member gets connected. This is the durable audit trail behind
// Member.referredByMemberId/referredByCode — "attribution even months later"
// even if the referrer or the application is later deleted.
model ReferralLink {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  referrerMemberId String         @db.Uuid
  referrerRole     MemberRole
  referralCode     String
  source           ReferralSource
  status           ReferralStatus @default(PENDING)
  applicationId    String?        @unique @db.Uuid
  memberId         String?        @unique @db.Uuid
  referredAt       DateTime       @default(now())
  approvedAt       DateTime?
  connectedAt      DateTime?
  rejectedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer     Member                 @relation("ReferralLinkReferrer", fields: [referrerMemberId], references: [id], onDelete: Cascade)
  application  MembershipApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  member       Member?                @relation("ReferralLinkMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([organizationId, referrerMemberId])
  @@index([referralCode])
  @@index([status])
  @@map("referral_links")
}

enum ReferralSource {
  QR_CODE
  LINK
  MANUAL_ENTRY
}

enum ReferralStatus {
  PENDING // application submitted with this referral, awaiting review
  ACTIVE // application approved — Member created and connected to the referrer
  REJECTED // application rejected; referral never took effect
  TRANSFERRED // superseded by a Super Admin-authorized reassignment
}

// =============================================================================
// EXISTING AGENCY CLAIM WORKFLOW
// =============================================================================

enum AgencyMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum AgencyAccessStatus {
  PENDING
  ACTIVE
  REJECTED
}

// "If someone attempts to create an agency that already exists ... provide a
// button: Request Access to Existing Agency." One row per person who asked
// to join an existing agency's team instead of registering a duplicate.
// Approval sets Member.agencyId/agencyRole on the requester — it never
// mints a new referralCode, which is what makes "they inherit the agency's
// existing Agency ID and creator network" true by construction.
model AgencyAccessRequest {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  agencyId       String             @db.Uuid
  requesterId    String             @unique @db.Uuid
  role           AgencyMemberRole
  status         AgencyAccessStatus @default(PENDING)
  requestedAt    DateTime           @default(now())
  decidedAt      DateTime?
  decidedById    String?            @db.Uuid
  reviewNote     String?
  // "Creator Request Notes" — the creator's own answer to "Why are you
  // requesting to join this agency?", captured at request time (Apply,
  // Signup, or Settings manual entry) and shown to the agency's reviewers
  // alongside the request. Stored permanently — never cleared on
  // approval/rejection, so it stays part of the connection's history.
  requestNote    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agency       Member       @relation("AgencyAccessRequestAgency", fields: [agencyId], references: [id], onDelete: Cascade)
  requester    Member       @relation("AgencyAccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy    Member?      @relation("AgencyAccessRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, agencyId])
  @@index([status])
  @@map("agency_access_requests")
}

enum AgencyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// "Agency Invitations" — an Owner/Manager inviting a specific person by
// email to join their team, distinct from AgencyAccessRequest (which is a
// stranger's self-service request after hitting a duplicate-agency block).
// An accepted invitation grants access directly — the invite itself is the
// approval, mirroring how the platform's own admin Invitation model bypasses
// MembershipApplication review.
model AgencyInvitation {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  agencyId       String                 @db.Uuid
  fullName       String
  email          String
  role           AgencyMemberRole
  token          String                 @unique
  status         AgencyInvitationStatus @default(PENDING)
  invitedById    String                 @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?                @db.Uuid
  declinedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agency       Member       @relation("AgencyInvitationAgency", fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy    Member       @relation("AgencyInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   Member?      @relation("AgencyInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, agencyId])
  @@index([email])
  @@index([status])
  @@map("agency_invitations")
}

enum AgencyActivityType {
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_REVOKED
  TEAM_MEMBER_REMOVED
  ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  CREATOR_REQUEST_RECEIVED
  CREATOR_APPROVED
  CREATOR_REJECTED
  CREATOR_JOINED
  FIRST_GMV
  GMV_MILESTONE
  PROFILE_UPDATED
}

// "Team Activity Feed" — a pre-rendered, human-readable narrative of events
// scoped to one agency. Deliberately a separate table from AuditLog (which
// stays the generic, actor/entity-shaped compliance trail used across the
// whole app): milestones like GMV thresholds have no human actor, and this
// table's `message` is written once at log time rather than reconstructed
// per-render from raw before/after diffs.
model AgencyActivity {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  agencyId       String             @db.Uuid
  type           AgencyActivityType
  actorId        String?            @db.Uuid
  targetId       String?            @db.Uuid
  message        String
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agency       Member       @relation("AgencyActivityAgency", fields: [agencyId], references: [id], onDelete: Cascade)
  actor        Member?      @relation("AgencyActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  target       Member?      @relation("AgencyActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([organizationId, agencyId, createdAt])
  @@map("agency_activities")
}

// One entry per legal document a signup flow requires explicit consent for.
// DATA_PROCESSING has no standalone page of its own -- its clause lives inside
// the Privacy Policy page (see features/legal/documents) -- but is tracked as
// its own consent type since it's a legally distinct GDPR-style acceptance,
// not just "I read the privacy policy."
enum LegalDocumentType {
  TERMS
  PRIVACY
  DATA_PROCESSING
  MEDIA_RELEASE
  LIABILITY_RELEASE
}

// The durable consent record for an existing Member -- written directly at
// invite-based signup (Member already exists), or copied over from a
// MembershipApplicationLegalAcceptance row the moment an application is
// approved and its Member row is finally created (see
// materializeLegalAcceptancesForMember). version/acceptedAt/ipAddress/
// userAgent always reflect the *original* moment the person checked the box,
// never the approval moment. ipAddress is nullable because collecting it is
// itself a privacy-sensitive choice this app makes best-effort, not a
// guarantee -- "where permitted" per the compliance requirement.
model LegalAcceptance {
  id           String            @id @default(uuid()) @db.Uuid
  memberId     String            @db.Uuid
  documentType LegalDocumentType
  version      String
  accepted     Boolean           @default(true)
  acceptedAt   DateTime          @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime          @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, documentType, version])
  @@index([memberId])
  @@map("legal_acceptances")
}

// The pre-Member mirror of LegalAcceptance for the public /apply flow, where
// a MembershipApplication can sit PENDING for days before an admin approves
// it and a Member row is created. Captured at submission time so the
// timestamp/IP/user agent are never lost to that gap.
model MembershipApplicationLegalAcceptance {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  documentType  LegalDocumentType
  version       String
  accepted      Boolean           @default(true)
  acceptedAt    DateTime          @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime          @default(now())

  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, documentType, version])
  @@index([applicationId])
  @@map("membership_application_legal_acceptances")
}

// The 4 documents that actually have a page/content of their own --
// DATA_PROCESSING (a LegalDocumentType, used only for LegalAcceptance rows)
// is deliberately excluded, since its clause lives inside the Privacy
// Policy rather than as its own versioned document.
enum LegalPageType {
  TERMS
  PRIVACY
  MEDIA_RELEASE
  LIABILITY_RELEASE
}

enum LegalVersionStatus {
  DRAFT
  PUBLISHED
}

// Set only when a version is published -- drafts have no kind yet. MAJOR
// publishes require every member's re-acceptance; MINOR publishes update
// the displayed version without disturbing existing acceptances. Null on
// the very first published version of a document (nothing to compare
// against, so "major vs minor" doesn't yet apply).
enum LegalVersionKind {
  MAJOR
  MINOR
}

// One row per draft or published revision of a legal document -- editing
// never overwrites a prior row, so every version that was ever live stays
// permanently readable for compare/audit purposes. The single "current"
// version per documentType is derived (latest PUBLISHED row), never stored
// redundantly, so there's exactly one place version state can drift from.
model LegalDocumentVersion {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  documentType   LegalPageType
  version        String
  title          String
  summary        String
  sections       Json
  status         LegalVersionStatus @default(DRAFT)
  versionKind    LegalVersionKind?
  changeSummary  String?
  effectiveDate  DateTime?
  publishedAt    DateTime?
  publishedById  String?            @db.Uuid
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedBy  Member?      @relation("LegalDocumentVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdBy    Member?      @relation("LegalDocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, documentType, version])
  @@index([organizationId, documentType, status])
  @@map("legal_document_versions")
}

// The only schema addition in the "premium platform" UX initiative — every
// other sprint is presentation-layer only. Real self-service RSVP (going/
// maybe/not-going) needs persisted per-member state that nothing else in
// the schema could safely be repurposed to hold.
enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
  WAITLISTED
}

// Draft -> (submit) -> PendingApproval -> Admin decides:
//   Approve -> Published | Reject -> Rejected | Request Changes -> back to Draft (see Event.changeRequestNote)
// Published events can later be Cancelled or Archived by an Admin/Super Admin.
enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  CANCELLED
}

// 14 categories per the Event Management spec — each maps to an icon+color
// in src/features/events/config/event-categories.ts, not stored here so the
// visual treatment can change without a migration.
enum EventCategory {
  NETWORKING
  WORKSHOP
  CREATOR_MEETUP
  PODCAST_RECORDING
  PHOTOSHOOT
  BRAND_ACTIVATION
  PANEL_DISCUSSION
  LAUNCH_PARTY
  MASTERCLASS
  COMMUNITY_MIXER
  PRODUCT_DEMO
  AWARDS_CEREMONY
  HOLIDAY_CELEBRATION
  OTHER
}

enum EventCheckInMethod {
  QR
  MANUAL
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  title          String
  description    String?
  location       String?
  // Informational only for Reservation purposes — bookSpace never reads
  // Event rows. Conflict-checking (see event-space-availability.service.ts)
  // reads both tables directly instead of linking them structurally.
  spaceId        String?  @db.Uuid
  startTime      DateTime
  endTime        DateTime
  capacity       Int?
  imageUrl       String?
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  status   EventStatus   @default(DRAFT)
  category EventCategory @default(OTHER)

  // Proposal-form fields (Section 2 of the spec) — the host is often not the
  // submitting Member (e.g. an admin submits on a sponsor's behalf), so this
  // is free text distinct from createdBy.
  hostName             String?
  hostContact          String?
  registrationDeadline DateTime?
  website              String?
  dressCode            String?
  foodProvided         Boolean   @default(false)
  parkingInfo          String?
  equipmentNeeded      String[]  @default([])
  // Future-ready per the spec's closing section — accepted and stored, not
  // yet rendered by any player/checkout UI.
  livestreamUrl        String?
  ticketPriceCents     Int?
  isPrivate            Boolean   @default(false)

  // Array of {name, logoUrl, message?, ctaLabel?, ctaLink?}, same shape and
  // rationale as KioskTheme.sponsors (theme/event-scoped, not queried
  // independently).
  sponsors Json?

  // "Only one featured event at a time" — enforced in the service layer via
  // a transactional unset-then-set, mirroring KioskTheme.isPinnedLive.
  isFeatured Boolean @default(false)
  viewCount  Int     @default(0)

  submittedAt        DateTime?
  approvedById       String?   @db.Uuid
  approvedAt         DateTime?
  rejectedById       String?   @db.Uuid
  rejectedAt         DateTime?
  rejectionReason    String?
  // Admin feedback from "Request Changes" — persists until the member edits
  // and resubmits (status returns to DRAFT rather than a separate status).
  changeRequestNote  String?
  cancelledById      String?   @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?
  archivedAt         DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  createdBy    Member         @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy   Member?        @relation("EventApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy   Member?        @relation("EventRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  cancelledBy  Member?        @relation("EventCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  rsvps        EventRsvp[]
  checkIns     EventCheckIn[]
  kioskThemes  KioskTheme[]
  qrAsset      QRAsset?

  @@index([organizationId])
  @@index([startTime])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@map("events")
}

model EventRsvp {
  id                 String     @id @default(uuid()) @db.Uuid
  eventId            String     @db.Uuid
  memberId           String     @db.Uuid
  status             RsvpStatus
  // Only set while status = WAITLISTED — earliest position is promoted
  // first when a GOING spot opens up.
  waitlistPosition   Int?
  reminderSentAt     DateTime?
  startingSoonSentAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
  @@map("event_rsvps")
}

model EventCheckIn {
  id            String             @id @default(uuid()) @db.Uuid
  eventId       String             @db.Uuid
  memberId      String             @db.Uuid
  checkedInAt   DateTime           @default(now())
  // Null when self-service (kiosk QR scan); set when an admin manually
  // checks someone in from the Event Dashboard.
  checkedInById String?            @db.Uuid
  method        EventCheckInMethod @default(QR)

  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member  @relation("EventCheckInMember", fields: [memberId], references: [id], onDelete: Cascade)
  checkedInBy Member? @relation("EventCheckInStaff", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([eventId, memberId])
  @@index([eventId])
  @@map("event_check_ins")
}

// =============================================================================
// MEMBERSHIP PLANS
// =============================================================================
// Internal plan/billing tracking — no payment processor is wired up. Fees are
// recorded as they're collected outside the app via MembershipPayment; this
// is intentionally not a Stripe-backed subscription system.

enum BillingInterval {
  MONTHLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model MembershipPlan {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  name            String
  description     String?
  priceCents      Int
  billingInterval BillingInterval @default(MONTHLY)
  trialMonths     Int             @default(0)
  // Free-text marketing bullets not tied to access control (e.g. "Creator
  // Profile," "Community Access") — structured, enforceable benefits live in
  // MembershipPlanFeatureValue instead (see that model's comment).
  benefits        String[]        @default([])
  // Which Role this plan is for — null means a generic/default plan
  // usable by anyone. Lets multiple targeted plans (Creator/Brand/Agency/...)
  // coexist per org without a schema change; getActivePlan() picks the
  // best match for a given role.
  appliesTo       MemberRole?
  isActive        Boolean         @default(true)
  // Lowest sortOrder among active plans targeting a Role is also the plan
  // getActivePlan() grants on approval — reordering a package to the front
  // makes it the new default trial plan, same as most SaaS "which tier is
  // the entry tier" behavior.
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions       MemberSubscription[]
  featureValues       MembershipPlanFeatureValue[]
  pricingSchedules    MembershipPricingSchedule[]
  lifecycleEventsFrom MembershipLifecycleEvent[]   @relation("MembershipLifecycleFromPlan")
  lifecycleEventsTo   MembershipLifecycleEvent[]   @relation("MembershipLifecycleToPlan")

  @@index([organizationId])
  @@map("membership_plans")
}

// =============================================================================
// CONFIGURABLE MEMBERSHIP FEATURES (the "package benefits" engine)
// =============================================================================
// A Super Admin defines feature TYPES here (e.g. "Board Room Access",
// "Guest Passes Per Day") without touching code, then sets a value per plan
// via MembershipPlanFeatureValue. Access-control code (bookSpace, event
// RSVP, etc.) reads these values by `key` rather than hardcoding
// package-specific logic — adding a new package or a new benefit type never
// requires a schema change or a redeploy, only new rows.

enum MembershipFeatureValueType {
  BOOLEAN
  NUMBER
  TEXT
}

// Usage-counter features (guest passes, event credits) need to know how
// often their per-member consumption resets — NONE means the feature is a
// static entitlement (e.g. Board Room Access), not a consumable counter.
enum MembershipFeatureResetPeriod {
  NONE
  DAILY
  MONTHLY
}

model MembershipFeature {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  // Stable machine key access-control code reads by (e.g. "board_room_access")
  // — never shown to users, never changes even if `label` is edited.
  key            String
  label          String
  description    String?
  valueType      MembershipFeatureValueType
  resetPeriod    MembershipFeatureResetPeriod @default(NONE)
  isActive       Boolean                      @default(true)
  sortOrder      Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planValues    MembershipPlanFeatureValue[]
  usageCounters MembershipUsageCounter[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@map("membership_features")
}

// One row = "this plan includes this feature, at this value." A feature
// with no row for a given plan means that plan doesn't include it at all
// (e.g. Basic has no row for Board Room Access). Exactly one of
// bool/number/textValue is populated, matching the feature's valueType.
model MembershipPlanFeatureValue {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  featureId       String   @db.Uuid
  boolValue       Boolean?
  numberValue     Int?
  textValue       String?
  // NUMBER features only — "Unlimited Podcast Room Access" instead of a
  // literal count.
  isUnlimited     Boolean  @default(false)
  // Optional full bullet-text override (e.g. "6 Guest Passes per day
  // (Company Meetings)") — falls back to an auto-generated line from
  // feature.label + the value when unset.
  displayOverride String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan    MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature MembershipFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("membership_plan_feature_values")
}

// Per-member, per-period consumption of a usage-limited feature (guest
// passes reset DAILY, event credits reset MONTHLY — see resetPeriod).
// `period` is "YYYY-MM-DD" for DAILY, "YYYY-MM" for MONTHLY, computed by
// the service layer, never by the client, so a member can't backdate usage.
model MembershipUsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  featureId String   @db.Uuid
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  member  Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feature MembershipFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([memberId, featureId, period])
  @@index([featureId, period])
  @@map("membership_usage_counters")
}

// A future price change queued by a Super Admin ("Schedule future pricing
// changes") — applied by a daily sweep once `effectiveAt` passes, leaving
// `appliedAt` as the audit trail of when it actually took effect.
model MembershipPricingSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @db.Uuid
  newPriceCents Int
  effectiveAt   DateTime
  appliedAt     DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())

  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy Member?        @relation("MembershipPricingScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([effectiveAt, appliedAt])
  @@map("membership_pricing_schedules")
}

enum MembershipLifecycleEventType {
  SUBSCRIBED
  TRIAL_CONVERTED
  UPGRADED
  DOWNGRADED
  CANCELED
  RESUMED
  EXPIRED
  PAST_DUE
}

// The single append-only log every membership analytics number (MRR
// history, upgrades, downgrades, churn, trial conversions) is computed
// from — written at each lifecycle transition point rather than derived
// from MemberSubscription's current-state-only columns.
model MembershipLifecycleEvent {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  memberId       String                       @db.Uuid
  type           MembershipLifecycleEventType
  fromPlanId     String?                      @db.Uuid
  toPlanId       String?                      @db.Uuid
  metadata       Json?
  createdAt      DateTime                     @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member          @relation("MembershipLifecycleEventMember", fields: [memberId], references: [id], onDelete: Cascade)
  fromPlan     MembershipPlan? @relation("MembershipLifecycleFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       MembershipPlan? @relation("MembershipLifecycleToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, createdAt])
  @@index([memberId])
  @@map("membership_lifecycle_events")
}

model MemberSubscription {
  id                        String             @id @default(uuid()) @db.Uuid
  memberId                  String             @unique @db.Uuid
  planId                    String             @db.Uuid
  status                    SubscriptionStatus @default(TRIALING)
  startedAt                 DateTime           @default(now())
  trialEndsAt               DateTime?
  currentPeriodEnd          DateTime?
  // When a cancellation takes effect — access continues until this date
  // ("cancel at period end"), distinct from canceledAt (when cancel was
  // requested). Also used by the PAST_DUE/CANCELED -> EXPIRED lifecycle sweep.
  cancelAt                  DateTime?
  canceledAt                DateTime?
  trialEndingSoonNotifiedAt DateTime?
  // Unused until a real payment gateway is integrated — reserved so that
  // integration has somewhere to write without another migration.
  paymentProviderCustomerId String?
  externalSubscriptionId    String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  member   Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     MembershipPlan      @relation(fields: [planId], references: [id])
  payments MembershipPayment[]

  @@index([planId])
  @@map("member_subscriptions")
}

model MembershipPayment {
  id                   String   @id @default(uuid()) @db.Uuid
  memberSubscriptionId String   @db.Uuid
  amountCents          Int
  paidAt               DateTime @default(now())
  note                 String?
  createdAt            DateTime @default(now())

  subscription MemberSubscription @relation(fields: [memberSubscriptionId], references: [id], onDelete: Cascade)

  @@index([memberSubscriptionId])
  @@map("membership_payments")
}

// =============================================================================
// SOCIAL CONNECTIONS
// =============================================================================
// Real OAuth connections to social platforms for follower-count sync.
// gmvSyncedCents/commissionSyncedCents stay null for these platforms — they
// exist so a future commerce-platform connector (e.g. Shopify) doesn't need
// a schema change.

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum SocialConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model SocialConnection {
  id                    String                 @id @default(uuid()) @db.Uuid
  memberId              String                 @db.Uuid
  platform              SocialPlatform
  status                SocialConnectionStatus @default(DISCONNECTED)
  externalAccountId     String?
  externalUsername      String?
  followerCount         Int?
  profileImageUrl       String? // avatar — all 3 platforms
  followingCount        Int? // TikTok following_count, Instagram follows_count; null for YouTube
  postCount             Int? // Instagram media_count, YouTube statistics.videoCount; null for TikTok
  likesCount            Int? // TikTok total-likes metric only
  engagementRate        Decimal?               @db.Decimal(5, 2) // percent, e.g. 3.42 — no provider populates this yet; reserved so a future metric doesn't need another migration
  accountType           String? // Instagram only: "PERSONAL" | "BUSINESS" | "MEDIA_CREATOR"; free-form so other platforms can reuse without a migration
  accessTokenEnc        String?
  refreshTokenEnc       String?
  tokenExpiresAt        DateTime?
  gmvSyncedCents        Int?
  commissionSyncedCents Int?
  lastSyncedAt          DateTime?
  lastSyncError         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, platform])
  @@map("social_connections")
}

// =============================================================================
// STORE CONNECTIONS
// =============================================================================
// Real OAuth connections to e-commerce platforms for revenue sync. Generic
// enough for Shopify today and other store providers later (WooCommerce,
// BigCommerce) without a UI or schema change — same future-proofing idiom as
// SocialConnection above and GMVTransaction.syncSource/externalId.

enum StoreProvider {
  SHOPIFY
}

enum StoreConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model StoreConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  memberId              String                @db.Uuid
  provider              StoreProvider
  status                StoreConnectionStatus @default(DISCONNECTED)
  storeName             String?
  storeDomain           String? // e.g. "acme.myshopify.com" — needed before OAuth can even start, unlike the social platforms
  externalAccountId     String?
  accessTokenEnc        String?
  refreshTokenEnc       String?
  tokenExpiresAt        DateTime?
  gmvSyncedCents        Int? // populated once a real revenue-sync job ships; null until then
  commissionSyncedCents Int?
  revenueSyncStatus     String? // "idle" | "syncing" | "error" — separate from connection `status`
  lastSyncedAt          DateTime?
  lastSyncError         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, provider])
  @@map("store_connections")
}

// =============================================================================
// DYNAMIC KIOSK EXPERIENCE SYSTEM
// =============================================================================

enum KioskThemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KioskAnimationStyle {
  FADE
  SLIDE
  ZOOM
  NONE
}

enum KioskLogoVariant {
  DEFAULT
  LIGHT
  DARK
  HIDDEN
  CUSTOM
}

enum KioskButtonStyle {
  SOLID
  OUTLINE
  GLASS
  GRADIENT
}

// A closed, reusable catalog of visual flourishes rather than free-form
// theming — each value maps to a generic, theme-color-tinted CSS/motion
// effect (see kiosk-decorative-elements.config.ts), so any future theme can
// mix-and-match them without a code change even though the effects
// themselves are a fixed set.
enum KioskDecorativeElement {
  SNOWFALL
  CHRISTMAS_LIGHTS
  DECORATED_TREES
  WRAPPED_GIFTS
  GOLD_GLOW
  PUMPKINS
  SPIDER_WEBS
  PURPLE_LIGHTING
  FLOATING_GHOSTS
  ANIMATED_BATS
  LUXURY_VIGNETTE
  LEATHER_TEXTURE
  WHISKEY_GLOW
  WARM_LIGHTING
  COPPER_ACCENTS
  CONFETTI
  SPARKLES
  BOKEH_LIGHTS
}

// "Schedule by Date / by Time / by Day of Week / Recurring Themes" — NONE
// means the plain startDate..endDate (+ optional startTime..endTime) window
// is the whole schedule; WEEKLY/MONTHLY_NTH_WEEKDAY layer a repeating rule
// on top of that same window (never outside it).
enum KioskRecurrence {
  NONE
  WEEKLY
  MONTHLY_NTH_WEEKDAY
}

enum KioskSectionType {
  HERO
  WELCOME_MESSAGE
  EVENT_BANNER
  ANNOUNCEMENTS
  SPONSORS
  FEATURED_CREATOR
  FEATURED_BRAND
  HIGHLIGHTS
  QR_CHECKIN
  REGISTER_NOW
  CUSTOM
}

enum KioskAnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KioskInteractionType {
  THEME_VIEW
  QR_SCAN
  CHECK_IN
  REGISTRATION
  CTA_CLICK
  EVENT_SIGNUP
}

/**
 * Every row is one version of a theme — never mutated once published, same
 * versioning convention as LegalDocumentVersion. `themeKey` groups all
 * versions of "the same theme" (stable across edits; a NEW themeKey is
 * minted only by Duplicate, never by editing or rolling back). The "current"
 * row for a themeKey is the one with the highest `version`; editing a
 * PUBLISHED/ARCHIVED theme creates a new DRAFT version rather than mutating
 * history, editing an already-DRAFT version updates it in place, and
 * "Roll Back to Previous Version" creates a new PUBLISHED version copying an
 * older version's fields (so history only ever grows, never rewrites).
 * Only one theme per organization may be resolved "live" at a time — decided
 * at read time by src/features/kiosk/services/kiosk-theme-resolution.service.ts,
 * never stored as a boolean here (a stored "is live" flag would drift the
 * instant the clock crosses a schedule boundary with nobody watching).
 */
model KioskTheme {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  themeKey       String           @db.Uuid
  version        Int              @default(1)
  status         KioskThemeStatus @default(DRAFT)

  name        String
  headline    String
  subheadline String?
  location    String?

  backgroundImageUrl String?
  backgroundVideoUrl String?
  logoOverrideUrl    String?
  logoVariant        KioskLogoVariant    @default(DEFAULT)
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  buttonColor        String?
  buttonTextColor    String?
  buttonStyle        KioskButtonStyle    @default(SOLID)
  textColor          String?
  animationStyle     KioskAnimationStyle @default(FADE)
  // Named palette shown in the editor as a reference swatch list (e.g.
  // "Snow White #FFFFFF") and used to tint decorativeElements — separate
  // from the functional colors above, which drive actual UI chrome.
  themeColors Json? // array of { name: string, hex: string }

  decorativeElements KioskDecorativeElement[] @default([])

  ctaLabel String?
  ctaLink  String?

  showQrRegistration Boolean @default(false)

  // Inline "Featured Event" card content for themes with no linked Event —
  // reuses this row's own startDate/startTime/endTime/location fields for
  // when/where, so date/time is never duplicated in two places. Ignored
  // (superseded by live Event data) whenever eventId is set.
  featuredEventTitle String?
  featuredEventTags  String[] @default([])

  promoBannerText String?
  promoBannerLink String?

  // Scheduling window — also doubles as the hero's displayed date/time
  // ("Tonight 6:00 PM – 9:00 PM") so there's exactly one place editors set
  // "when this happens," not two that could disagree.
  startDate DateTime
  endDate   DateTime
  startTime String? // "HH:mm", 24h; null = all-day
  endTime   String?

  recurrence           KioskRecurrence @default(NONE)
  recurrenceDaysOfWeek Int[]           @default([]) // 0=Sun..6=Sat, WEEKLY only
  recurrenceNthWeek    Int? // 1-5, MONTHLY_NTH_WEEKDAY only ("First Monday")
  recurrenceWeekday    Int? // 0=Sun..6=Sat, MONTHLY_NTH_WEEKDAY only

  showCountdown Boolean @default(false)

  // "If an Event exists ... Use Event as Kiosk Theme ... No duplicate entry
  // required" — when set, the theme's displayed title/description/date/
  // location/banner are read live from the Event rather than duplicated
  // onto this row (see resolveThemeContent in the theme service).
  eventId String? @db.Uuid

  // Array of {name, logoUrl, message?, ctaLabel?, ctaLink?} — deliberately a
  // JSON list rather than a join table: sponsors are theme-scoped, never
  // queried independently, and the shape is still evolving (see spec's
  // "Future Ready" — sponsor carousels).
  sponsors Json?

  isDefault    Boolean @default(false) // fallback theme when nothing else matches
  isPinnedLive Boolean @default(false) // manual "force live now" override
  priority     Int     @default(0) // tie-break when multiple schedules overlap

  changeSummary String? // what changed this version (shown in version history)

  publishedAt   DateTime?
  publishedById String?   @db.Uuid
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  publishedBy  Member?      @relation("KioskThemePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdBy    Member?      @relation("KioskThemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, themeKey, version])
  @@index([organizationId, themeKey])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("kiosk_themes")
}

/**
 * "Homepage Builder" — one row per section per organization, ordering and
 * enabling/disabling the kiosk's home-screen sections. Theme-independent
 * (the same layout applies regardless of which theme is currently live).
 */
model KioskSectionConfig {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  sectionType    KioskSectionType
  // Stable identity for this row beyond sectionType alone — lets CUSTOM
  // sections repeat (sectionType=CUSTOM, key="custom-<uuid>") while HERO/
  // WELCOME_MESSAGE/etc stay singleton via key===sectionType.
  key            String
  label          String? // display name, required/used for CUSTOM sections
  order          Int
  enabled        Boolean          @default(true)
  config         Json? // arbitrary per-section settings, future-ready
  updatedById    String?          @db.Uuid
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    Member?      @relation("KioskSectionConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([organizationId, order])
  @@map("kiosk_section_configs")
}

model KioskAnnouncement {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  title          String
  description    String?
  imageUrl       String?
  ctaLabel       String?
  ctaLink        String?
  priority       Int                     @default(0)
  isPinned       Boolean                 @default(false)
  status         KioskAnnouncementStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  createdById    String?                 @db.Uuid
  updatedById    String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         Member?                 @relation("KioskAnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         Member?                 @relation("KioskAnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  interactionEvents KioskInteractionEvent[]

  @@index([organizationId, status])
  @@map("kiosk_announcements")
}

/**
 * "Analytics" — one row per interaction. `themeKey` (not a specific
 * version's id) so views/clicks roll up across every edit of the same
 * theme, matching how the analytics dashboard reports "per theme," not
 * "per version." No FK to KioskTheme (themeKey isn't a primary key) —
 * resolved by application code, same tradeoff as ReferralLink.referralCode.
 */
model KioskInteractionEvent {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  type           KioskInteractionType
  themeKey       String?              @db.Uuid
  announcementId String?              @db.Uuid
  metadata       Json?
  occurredAt     DateTime             @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  announcement KioskAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, occurredAt])
  @@index([organizationId, themeKey])
  @@map("kiosk_interaction_events")
}
