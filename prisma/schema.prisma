  collabPost CollabPost @relation(fields: [collabPostId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([collabPostId, memberId])
  @@index([collabPostId])
  @@map("collab_post_likes")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  Member @relation("MemberFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following Member @relation("MemberFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// Generic member-to-member direct messaging — independent of Collab Hub's
// CollabPost-scoped Conversation/Message above, which stays untouched.
// Participant-based (not a fixed 2-party poster/initiator pair) so group
// chats can be added later without another migration.
model DirectConversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  isGroup        Boolean  @default(false)
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@index([organizationId])
  @@map("direct_conversations")
}

model DirectConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  memberId       String    @db.Uuid
  lastReadAt     DateTime?
  typingAt       DateTime?
  joinedAt       DateTime  @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId])
  @@map("direct_conversation_participants")
}

model DirectMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  senderId       String            @db.Uuid
  type           DirectMessageType @default(TEXT)
  body           String?
  attachmentUrl  String?
  createdAt      DateTime          @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Member             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}

