// =============================================================================

enum RevenueChannel {
  BRAND_DEALS
  TIKTOK_SHOP
  ONLINE_STORE
  AFFILIATE
  UGC_PROJECTS
  REFERRALS
  OTHER
}

model GMVTransaction {
  id              String         @id @default(uuid()) @db.Uuid
  memberId        String         @db.Uuid
  projectId       String?        @db.Uuid
  companyId       String?        @db.Uuid
  brandId         String?        @db.Uuid
  amount          Decimal        @db.Decimal(14, 2)
  description     String?
  source          String? // freeform label (e.g. "Nike Campaign") — distinct from `channel` below
  channel         RevenueChannel @default(OTHER)
  externalId      String? // idempotency key for a future automated connector (TikTok Shop, Stripe, etc.); null for manual entries
  syncSource      String? // e.g. "tiktok_shop", "stripe_connect" — origin tag for a future connector, mirrors SocialConnection's future-sync idiom; null for manual entries
