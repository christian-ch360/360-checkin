// =============================================================================
// CreatorHub360 Operations Platform — Database Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  PROJECT_LEADER
  MEMBER
  GUEST
}

enum MemberRole {
  BRAND
  AGENCY
  BROKER
  BUSINESS_DEVELOPMENT
  CREATOR
  PROJECT_LEADER
  VENDOR
  STAFF
  ENTERTAINMENT
  INVESTOR
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

enum CommissionTierCode {
  A
  B
  C
  D
  E
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REMOVED
}

enum CheckInStatus {
  CHECKED_IN
  CHECKED_OUT
}

enum QRAssetType {
  MEMBER
  PROJECT
  BRAND
  SPACE
  EVENT
  VISITOR
  LOCATION
}

enum VisitorType {
  BRAND
  CREATOR
  AGENCY
  VENDOR
  BROKER
  MEDIA
  INTERVIEW
  GUEST
  OTHER
}

enum VisitorStatus {
  WAITING
  APPROVED
  CHECKED_OUT
}

enum SpaceType {
  PODCAST_BOOTH
  EDITING_SUITE
  PHOTOGRAPHY_STUDIO
  CONFERENCE_ROOM
  MEETING_ROOM
  CREATOR_LOUNGE
  BEAUTY_STATION
  RECORDING_STUDIO
  LIVESTREAM_STUDIO
  CONTENT_LAB
  EVENT_SPACE
  CONTENT_BOOTH
}

enum SpaceSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  CHECK_IN
  CHECK_OUT
  PROJECT_ASSIGNED
  GMV_ENTERED
  COMMISSION_GENERATED
  SPACE_STARTED
  SPACE_FINISHED
  MENTION
  COMMENT
  DEADLINE
  FEEDBACK_SUBMITTED
  SYSTEM
  COLLAB_MESSAGE_RECEIVED
  DIRECT_MESSAGE_RECEIVED
  COLLAB_APPLICATION_RECEIVED
  COLLAB_APPLICATION_ACCEPTED
  COLLAB_POST_CLOSED
  MEMBERSHIP_APPLICATION_RECEIVED
  LIKE
  NEW_FOLLOWER
  LEGAL_DOCUMENT_UPDATED
  AGENCY_REQUEST_RECEIVED
  AGENCY_REQUEST_APPROVED
  AGENCY_REQUEST_REJECTED
  AGENCY_ACCESS_REQUESTED
  AGENCY_ACCESS_APPROVED
  AGENCY_ACCESS_REJECTED
  TEAM_INVITATION_SENT
  TEAM_INVITATION_ACCEPTED
  TEAM_INVITATION_DECLINED
  TEAM_INVITATION_REVOKED
  TEAM_ROLE_CHANGED
  TEAM_OWNERSHIP_TRANSFERRED
  TEAM_MEMBER_REMOVED
  EVENT_PROPOSAL_SUBMITTED
  EVENT_APPROVED
  EVENT_REJECTED
  EVENT_CHANGES_REQUESTED
  EVENT_CAPACITY_REACHED
  EVENT_CANCELLED
  EVENT_WAITLIST_PROMOTED
}

enum FeedbackCategory {
  PLATFORM
  FACILITY
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum CollabPostCategory {
  CREATOR
  BRAND
  AGENCY
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
  MODEL
  PODCAST
  UGC
}

enum CollabBudgetType {
  PAID
  TRADE
  FREE
}

enum CollabLocation {
  ON_SITE
  REMOTE
}

enum CollabPostStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  PROJECT_REF
  RESERVATION_REF
  VOICE
}

enum DirectMessageType {
  TEXT
  IMAGE
  FILE
  VOICE
}

// =============================================================================
// CORE / ORGANIZATION
// =============================================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                   Member[]
  companies                 Company[]
  brands                    Brand[]
  projects                  Project[]
  spaces                    Space[]
  reservations              Reservation[]
  commissionTiers           CommissionTier[]
  invitations               Invitation[]
  activityLogs              ActivityLog[]
  auditLogs                 AuditLog[]
  files                     File[]
  feedback                  Feedback[]
  collabPosts               CollabPost[]
  conversations             Conversation[]
  directConversations       DirectConversation[]
  visitors                  Visitor[]
  locations                 Location[]
  emailLogs                 EmailLog[]
  membershipApplications    MembershipApplication[]
  events                    Event[]
  membershipPlans           MembershipPlan[]
  projectInvitations        ProjectInvitation[]
  legalDocumentVersions     LegalDocumentVersion[]
  referralLinks             ReferralLink[]
  agencyAccessRequests      AgencyAccessRequest[]
  agencyInvitations         AgencyInvitation[]
  agencyActivities          AgencyActivity[]
  kioskThemes               KioskTheme[]
  kioskSectionConfigs       KioskSectionConfig[]
  kioskAnnouncements        KioskAnnouncement[]
  kioskInteractionEvents    KioskInteractionEvent[]
  membershipFeatures        MembershipFeature[]
  membershipLifecycleEvents MembershipLifecycleEvent[]

  @@map("organizations")
}

// =============================================================================
// MEMBERS
// =============================================================================

model Member {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  memberNumber   String  @unique // CH360-000001
  authUserId     String? @unique @db.Uuid // Supabase auth.users.id

  fullName        String
  email           String  @unique
  phone           String?
  profilePhotoUrl String?
  website         String?

  // "Agency Uniqueness" — an optional business registration/EIN number,
  // checked alongside fullName (business name) and website (domain) to
  // detect duplicate agency records before they're created. Only ever
  // populated for referral-eligible roles in practice; nullable everywhere
  // else since most member types have no such identifier.
  businessRegistrationNumber String?
  // "Agency Settings" — free-text categories the agency operates in (e.g.
  // "Beauty", "Gaming"), shown on the creator-facing preview. Same
  // referral-eligible-role-only convention as the fields above.
  agencyCategories           String[] @default([])

  companyId      String?    @db.Uuid
  role           MemberRole
  systemRole     SystemRole @default(MEMBER)
  referralSource String?

  // Affiliate/referral tracking — permanent, auto-generated, globally unique
  // per referring member (e.g. "AGY-001284" for an AGENCY). Nullable because
  // only referral-eligible roles get one (see REFERRAL_ELIGIBLE_ROLES); never
  // reassigned once minted, so it's always safe to bake into a printed QR
  // code. referredByMemberId/referredByCode capture the *other* side — which
  // referrer (if any) this member arrived through. referredByCode is a
  // permanent snapshot of the code at connection time, kept even if
  // referredByMemberId is later nulled out (referrer deleted), so GMV
  // attribution history survives independent of the live relation.
  referralCode       String? @unique
  referredByMemberId String? @db.Uuid
  referredByCode     String?

  // "Existing Agency Claim Workflow" — null on a canonical/root agency
  // (they ARE the agency identity holding referralCode). Set on a team
  // member who was granted access to an *existing* agency instead of
  // creating a duplicate one: they "inherit the agency's existing Agency ID
  // and creator network" by pointing here rather than ever minting their
  // own referralCode. agencyRole is only meaningful when agencyId is set.
  agencyId   String?           @db.Uuid
  agencyRole AgencyMemberRole?

  commissionTierId String? @db.Uuid

  currentGMV         Decimal @default(0) @db.Decimal(14, 2)
  lifetimeGMV        Decimal @default(0) @db.Decimal(14, 2)
  currentCommission  Decimal @default(0) @db.Decimal(14, 2)
  lifetimeCommission Decimal @default(0) @db.Decimal(14, 2)
  hoursWorked        Decimal @default(0) @db.Decimal(10, 2)

  status      MemberStatus @default(ACTIVE)
  memberSince DateTime     @default(now())
  deletedAt   DateTime?

  // Approval workflow — set when a PENDING application is approved/rejected.
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  rejectedById    String?   @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?

  // Creator application info, collected at signup, shown only "if applicable"
  // (Applied Member Type == CREATOR) on the application detail view.
  followerCount Int?
  platforms     String[] @default([])

  // Creator Dashboard identity — username/displayName are optional, distinct
  // from fullName (which stays the formal/legal name shown in admin tables).
  username           String?            @unique
  displayName        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  bannerImageUrl     String?
  location           String?

  // Collab Hub profile — self-service, shown in the creator matchmaking directory
  bio                String?
  skills             String[]          @default([])
  contentCategories  ContentCategory[] @default([])
  availableForCollab Boolean           @default(true)
  visibleInDirectory Boolean           @default(true)
  lookingFor         String?
  instagramUrl       String?
  tiktokUrl          String?
  youtubeUrl         String?
  linkedinUrl        String?

  // Notification preferences — self-service, read/written only from Settings.
  // Each gates both an in-app Notification and the matching outbound email
  // for its category; notifyWeeklySummary/notifyProductUpdates still have no
  // producer (no weekly-digest/product-update feature exists yet).
  notifyEmail           Boolean @default(true)
  notifyCollabRequests  Boolean @default(true)
  notifyProjectInvites  Boolean @default(true)
  notifySpaceBookings   Boolean @default(true)
  notifyVisitorArrivals Boolean @default(true)
  notifyWeeklySummary   Boolean @default(true)
  notifyProductUpdates  Boolean @default(false)
  notifyLikes           Boolean @default(true)
  notifyFollows         Boolean @default(true)
  notifyComments        Boolean @default(true)
  notifyMentions        Boolean @default(true)

  // Super Admin only — Settings > Developer Tools toggle. Swaps the UI's
  // data source to a purely in-memory demo dataset; never affects any row
  // other than this one.
  demoModeEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id])
  commissionTier CommissionTier? @relation(fields: [commissionTierId], references: [id])
  approvedBy     Member?         @relation("MemberApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy     Member?         @relation("MemberRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  referredBy     Member?         @relation("MemberReferrals", fields: [referredByMemberId], references: [id], onDelete: SetNull)
  agency         Member?         @relation("AgencyTeam", fields: [agencyId], references: [id], onDelete: SetNull)

  approvedMembers                   Member[]                        @relation("MemberApprovedBy")
  rejectedMembers                   Member[]                        @relation("MemberRejectedBy")
  notesAuthored                     MemberNote[]                    @relation("MemberNoteAuthor")
  notesReceived                     MemberNote[]                    @relation("MemberNoteSubject")
  projectAssignments                ProjectAssignment[]
  leadingProjects                   Project[]                       @relation("ProjectLeader")
  checkIns                          CheckIn[]
  spaceSessions                     SpaceSession[]
  reservations                      Reservation[]
  commissionTransactions            CommissionTransaction[]
  gmvTransactions                   GMVTransaction[]
  payouts                           Payout[]
  qrAsset                           QRAsset?
  activityLogs                      ActivityLog[]
  notifications                     Notification[]
  files                             File[]
  invitedInvitations                Invitation[]                    @relation("InvitedBy")
  comments                          Comment[]
  feedback                          Feedback[]
  attendingReservations             Reservation[]                   @relation("ReservationAttendees")
  collabPosts                       CollabPost[]
  collabApplications                Application[]
  conversationsAsPoster             Conversation[]                  @relation("ConversationPoster")
  conversationsAsInitiator          Conversation[]                  @relation("ConversationInitiator")
  collabMessages                    Message[]
  directConversations               DirectConversationParticipant[]
  directMessages                    DirectMessage[]
  scanEvents                        ScanEvent[]
  emailLogsReceived                 EmailLog[]                      @relation("EmailLogRecipient")
  emailLogsSent                     EmailLog[]                      @relation("EmailLogSentBy")
  reviewedApplications              MembershipApplication[]         @relation("MembershipApplicationReviewedBy")
  notesUpdatedApplications          MembershipApplication[]         @relation("MembershipApplicationNotesUpdatedBy")
  createdEvents                     Event[]                         @relation("EventCreatedBy")
  eventRsvps                        EventRsvp[]
  subscription                      MemberSubscription?
  socialConnections                 SocialConnection[]
  storeConnections                  StoreConnection[]
  revenueGoal                       RevenueGoal?
  collabPostLikes                   CollabPostLike[]
  followers                         Follow[]                        @relation("MemberFollowers")
  following                         Follow[]                        @relation("MemberFollowing")
  sentProjectInvitations            ProjectInvitation[]             @relation("ProjectInvitationInvitedBy")
  collaborationRequests             ProjectCollaborationRequest[]
  legalAcceptances                  LegalAcceptance[]
  publishedLegalVersions            LegalDocumentVersion[]          @relation("LegalDocumentVersionPublishedBy")
  createdLegalVersions              LegalDocumentVersion[]          @relation("LegalDocumentVersionCreatedBy")
  referredMembers                   Member[]                        @relation("MemberReferrals")
  referralsMade                     ReferralLink[]                  @relation("ReferralLinkReferrer")
  referralConnection                ReferralLink?                   @relation("ReferralLinkMember")
  teamMembers                       Member[]                        @relation("AgencyTeam")
  agencyAccessRequestsMade          AgencyAccessRequest[]           @relation("AgencyAccessRequestRequester")
  agencyAccessRequestsReceived      AgencyAccessRequest[]           @relation("AgencyAccessRequestAgency")
  agencyAccessRequestsDecided       AgencyAccessRequest[]           @relation("AgencyAccessRequestDecidedBy")
  agencyInvitationsAgency           AgencyInvitation[]              @relation("AgencyInvitationAgency")
  agencyInvitationsSent             AgencyInvitation[]              @relation("AgencyInvitationInvitedBy")
  agencyInvitationsAccepted         AgencyInvitation[]              @relation("AgencyInvitationAcceptedBy")
  agencyActivitiesAgency            AgencyActivity[]                @relation("AgencyActivityAgency")
  agencyActivitiesActor             AgencyActivity[]                @relation("AgencyActivityActor")
  agencyActivitiesTarget            AgencyActivity[]                @relation("AgencyActivityTarget")
  kioskThemesPublished              KioskTheme[]                    @relation("KioskThemePublishedBy")
  kioskThemesCreated                KioskTheme[]                    @relation("KioskThemeCreatedBy")
  kioskSectionConfigsUpdated        KioskSectionConfig[]            @relation("KioskSectionConfigUpdatedBy")
  kioskAnnouncementsCreated         KioskAnnouncement[]             @relation("KioskAnnouncementCreatedBy")
  kioskAnnouncementsUpdated         KioskAnnouncement[]             @relation("KioskAnnouncementUpdatedBy")
  eventsApproved                    Event[]                         @relation("EventApprovedBy")
  eventsRejected                    Event[]                         @relation("EventRejectedBy")
  eventsCancelled                   Event[]                         @relation("EventCancelledBy")
  eventCheckIns                     EventCheckIn[]                  @relation("EventCheckInMember")
  eventCheckInsStaffed              EventCheckIn[]                  @relation("EventCheckInStaff")
  membershipUsageCounters           MembershipUsageCounter[]
  membershipLifecycleEvents         MembershipLifecycleEvent[]      @relation("MembershipLifecycleEventMember")
  membershipPricingSchedulesCreated MembershipPricingSchedule[]     @relation("MembershipPricingScheduleCreatedBy")

  @@index([organizationId])
  @@index([companyId])
  @@index([status])
  @@index([role])
  @@index([referredByMemberId])
  @@index([agencyId])
  @@map("members")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ContentCategory {
  FITNESS
  GAMING
  FASHION
  BEAUTY
  LIFESTYLE
  TECH
  FOOD
  TRAVEL
  COMEDY
  MUSIC
  DANCE
  BUSINESS
  ENTREPRENEURSHIP
  EDUCATION
  PHOTOGRAPHY
  MODELING
  SPORTS
  AUTOMOTIVE
  PARENTING
  PETS
  FINANCE
  LUXURY
  HEALTH
  ART
  DIY
  STREAMING
  VLOGS
  PODCASTS
}

// Private admin-only notes on a member's approval application. Append-only —
// the list itself is the history (author + timestamp per row); never
// visible to the member it's about.
model MemberNote {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  member Member @relation("MemberNoteSubject", fields: [memberId], references: [id], onDelete: Cascade)
  author Member @relation("MemberNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_notes")
}

// =============================================================================
// COMPANIES & BRANDS
// =============================================================================

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  logoUrl        String?
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         Member[]
  brands          Brand[]
  projects        Project[]
  gmvTransactions GMVTransaction[]
  spaceSessions   SpaceSession[]

  @@index([organizationId])
  @@map("companies")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  companyId      String?  @db.Uuid
  name           String
  logoUrl        String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id])
  projects           Project[]
  gmvTransactions    GMVTransaction[]
  spaceSessions      SpaceSession[]
  qrAsset            QRAsset?
  projectInvitations ProjectInvitation[]

  @@index([organizationId])
  @@index([companyId])
  @@map("brands")
}

// =============================================================================
// PROJECTS
// =============================================================================

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  projectCode     String        @unique // PRJ-000001
  name            String
  description     String?
  clientId        String?       @db.Uuid
  brandId         String?       @db.Uuid
  status          ProjectStatus @default(PLANNING)
  deadline        DateTime?
  projectLeaderId String?       @db.Uuid

  budget         Decimal @default(0) @db.Decimal(14, 2)
  gmv            Decimal @default(0) @db.Decimal(14, 2)
  commissionPool Decimal @default(0) @db.Decimal(14, 2)

  startDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Company?     @relation(fields: [clientId], references: [id])
  brand         Brand?       @relation(fields: [brandId], references: [id])
  projectLeader Member?      @relation("ProjectLeader", fields: [projectLeaderId], references: [id])

  assignments            ProjectAssignment[]
  tasks                  Task[]
  notes                  Note[]
  files                  File[]
  gmvTransactions        GMVTransaction[]
  commissionTransactions CommissionTransaction[]
  spaceSessions          SpaceSession[]
  comments               Comment[]
  qrAsset                QRAsset?
  reservations           Reservation[]
  collabMessageRefs      Message[]
  invitations            ProjectInvitation[]
  collaborationRequests  ProjectCollaborationRequest[]

  @@index([organizationId])
  @@index([status])
  @@index([brandId])
  @@index([projectLeaderId])
  @@map("projects")
}

model ProjectAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  memberId        String           @db.Uuid
  role            String
  commissionPct   Decimal          @default(0) @db.Decimal(5, 2)
  contributionPct Decimal          @default(0) @db.Decimal(5, 2)
  hours           Decimal          @default(0) @db.Decimal(10, 2)
  status          AssignmentStatus @default(ACTIVE)
  assignedAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("project_assignments")
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Invite an email address (optionally tied to a Brand) to collaborate on a
// Project — mirrors Invitation's token/expiry/status pattern but scoped to
// a project instead of the whole org. Acceptance marks the row ACCEPTED; an
// admin still finishes adding the invitee as a ProjectAssignment once they
// have a Member account, same as the org-invite flow today.
model ProjectInvitation {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  projectId      String                  @db.Uuid
  brandId        String?                 @db.Uuid
  email          String
  roleLabel      String
  invitedById    String                  @db.Uuid
  status         ProjectInvitationStatus @default(PENDING)
  token          String                  @unique
  expiresAt      DateTime
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id])
  invitedBy    Member       @relation("ProjectInvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([email])
  @@map("project_invitations")
}

enum CollaborationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// A member requesting to join a Project they're not assigned to. Accepting
// creates a ProjectAssignment.
model ProjectCollaborationRequest {
  id          String                     @id @default(uuid()) @db.Uuid
  projectId   String                     @db.Uuid
  memberId    String                     @db.Uuid
  message     String?
  status      CollaborationRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@map("project_collaboration_requests")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  assigneeId  String?   @db.Uuid
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("notes")
}

// A comment sets exactly one of projectId/collabPostId — enforced in the
// service layer (addProjectComment / addCollabPostComment), not by a DB
// constraint, since Prisma has no clean partial/conditional-check mechanism.
model Comment {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String?  @db.Uuid
  collabPostId String?  @db.Uuid
  memberId     String   @db.Uuid
  body         String
  mentions     String[] @default([])
  createdAt    DateTime @default(now())

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collabPost CollabPost? @relation(fields: [collabPostId], references: [id], onDelete: Cascade)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([collabPostId])
  @@map("comments")
}

// =============================================================================
// FACILITY CHECK-IN
// =============================================================================

model CheckIn {
  id        String        @id @default(uuid()) @db.Uuid
  memberId  String        @db.Uuid
  checkIn   DateTime      @default(now())
  checkOut  DateTime?
  duration  Int? // minutes; set on checkout, never overwritten after that
  status    CheckInStatus @default(CHECKED_IN)
  source    String        @default("qr") // qr | manual | usb_scanner
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([checkIn])
  @@map("check_ins")
}

// =============================================================================
// BOOTHS & ROOMS
// =============================================================================

model Space {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  type           SpaceType
  capacity       Int?
  location       String?
  equipment      String[]  @default([])
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     SpaceSession[]
