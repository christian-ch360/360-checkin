model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  memberId  String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Composite, matching the two actual query shapes in /api/notifications:
  // findMany(memberId, order by createdAt) and count(memberId, readAt: null).
  // The prior single-column @@index([memberId]) / @@index([readAt]) pair
  // couldn't satisfy either query without a separate sort/filter step.
  @@index([memberId, createdAt])
  @@index([memberId, readAt])
  @@map("notifications")
}

