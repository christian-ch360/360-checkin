model Conversation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  collabPostId   String @db.Uuid
  posterId       String @db.Uuid
  initiatorId    String @db.Uuid

  posterLastReadAt    DateTime?
  initiatorLastReadAt DateTime?
  posterTypingAt      DateTime?
  initiatorTypingAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collabPost   CollabPost   @relation(fields: [collabPostId], references: [id], onDelete: Cascade)
  poster       Member       @relation("ConversationPoster", fields: [posterId], references: [id], onDelete: Cascade)
  initiator    Member       @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([collabPostId, initiatorId])
  @@index([organizationId])
  @@index([posterId])
  @@index([initiatorId])
  @@map("collab_conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
