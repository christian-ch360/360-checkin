  body             String?
  attachmentUrl    String?
  projectRefId     String? @db.Uuid
  reservationRefId String? @db.Uuid

  createdAt DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Member       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  projectRef     Project?     @relation(fields: [projectRefId], references: [id])
  reservationRef Reservation? @relation(fields: [reservationRefId], references: [id])

